          "info": {
            "name": "Register For Loyalty Campaign By Card",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.amctheatres.com/v4/loyalty-accounts/card-:card-number/:campaign/registration",
            "params": [
              {
                "name": "card-number",
                "value": "",
