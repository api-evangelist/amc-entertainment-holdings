          "http": {
            "method": "DELETE",
            "url": "https://api.amctheatres.com/v4/amc-accounts/:amc-account-id/loyalty",
            "params": [
              {
                "name": "amc-account-id",
                "value": "",
                "type": "path"
              }
            ]
